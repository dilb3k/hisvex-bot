# --- Telegram ---
# Get this from @BotFather (New bot -> /newbot). This must be a NEW bot
# token, separate from comp-bar-server's existing BOT_TOKEN (that one only
# sends one-way admin activity notifications, it's not this interactive bot).
BOT_TOKEN="<your-telegram-bot-token>"

# Telegram user IDs (numeric, not usernames) allowed to approve/reject
# manual card payments and see the admin menu. Get a numeric id by DMing
# @userinfobot. Comma-separated for multiple admins.
ADMIN_TELEGRAM_IDS="123456789,987654321"

# Telegram chat id (a group, or an admin's own DM) where new manual-payment
# receipts are posted for approval. Can be the same as one of the admin
# ids above (their private chat id) if you don't want a separate group.
ADMIN_APPROVAL_CHAT_ID="123456789"

# --- Backend (comp-bar-server) ---
BACKEND_URL="https://hisvex-api-production.up.railway.app"
# Must match BOT_INTERNAL_SECRET set on the backend exactly.
BOT_INTERNAL_SECRET="<same-secret-as-backend-BOT_INTERNAL_SECRET>"

# --- Manual card-transfer payment ---
# Shown to a user who picks "Karta orqali" — no merchant account needed,
# works immediately. Update these to your real card.
CARD_NUMBER="8600 1234 5678 9012"
CARD_HOLDER_NAME="F. F. Familiya"

# --- Links shown in the bot ---
APP_DOWNLOAD_URL="https://hisvex-web.vercel.app"
SUPPORT_TELEGRAM_USERNAME="dilbek7011"

# --- Reminders ---
# How many days before expiry to DM a "your subscription is ending soon"
# reminder. Runs once a day.
REMINDER_DAYS_BEFORE="3"
